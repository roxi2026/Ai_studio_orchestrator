{
  "manifest_version": 3,
  "name": "Omnipotent AI Orchestrator",
  "version": "2.0.0",
  "description": "Transforms Google AI Studio into a universal, autonomous web agent capable of controlling any website.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["aistudio_content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://aistudio.google.com/*"]
    }
  ]
}
